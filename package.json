{
  "name": "linkrovia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "types": "wrangler types --config wrangler.jsonc --include-main-module false --env-file .dev.vars.example",
    "check": "npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:seed:local": "node scripts/seed-local.mjs",
    "timezone:generate": "node scripts/generate-timezones.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "vite": "^7.3.0",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  }
}
