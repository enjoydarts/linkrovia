{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "linkrovia-page-metadata",
  "main": "worker.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "containers": [
    {
      "class_name": "PageMetadataContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGE_METADATA_CONTAINER",
        "class_name": "PageMetadataContainer",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PageMetadataContainer"] },
  ],
}
